Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views

Visualization Manager:
  Displays:
    # TF Tree
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Marker Scale: 1.0
      Show Axes: true
      Show Names: true
      Update Interval: 0.0
      
    # Drone Odometry
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: Drone Odometry
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /odom
      Covariance:
        Orientation: false
        Position: false
      Keep: 100
      Position Tolerance: 0.1
      Shape:
        Alpha: 1.0
        Axes Length: 1.0
        Axes Radius: 0.1
        Color: 0; 255; 0
        Head Length: 0.3
        Head Radius: 0.1
        Shaft Length: 1.0
        Shaft Radius: 0.05
        Value: Arrow
        
    # Goal Pose
    - Class: rviz_default_plugins/Pose
      Enabled: true
      Name: Goal Pose
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_update
      Alpha: 1.0
      Color: 255; 0; 0
      Shaft Length: 2.0
      Shaft Radius: 0.3
      Head Length: 1.0
      Head Radius: 0.5
      
    # Global Path
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Global Path
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /plan
      Alpha: 1.0
      Buffer Length: 1
      Color: 255; 255; 0
      Line Style: Lines
      Line Width: 0.1
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Style: None
      
    # Local Path
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Local Path
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_plan
      Alpha: 1.0
      Buffer Length: 1
      Color: 0; 255; 255
      Line Style: Lines
      Line Width: 0.1
      
    # Transformed Global Plan
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Transformed Plan
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /transformed_global_plan
      Alpha: 0.7
      Buffer Length: 1
      Color: 255; 128; 0
      Line Style: Lines
      Line Width: 0.08
      
    # Robot Footprint
    - Class: rviz_default_plugins/Polygon
      Enabled: true
      Name: Robot Footprint
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_costmap/published_footprint
      Alpha: 0.7
      Color: 0; 0; 255
      
    # Markers
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Markers
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /marker
        
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
    
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
      
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 30.0
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1.0
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 5
      Pitch: 0.5
      Yaw: 0.785
